// Support / ops inbox assistant — single-workspace (NO multi-tenant by design).
// LlmCall is the observability spine: every model call writes a row here, and the
// cost dashboard + per-ticket cost readout both read from it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())

  orders  Order[]
  tickets Ticket[]

  @@index([email])
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(PAID)
  amountUsd   Decimal     @db.Decimal(10, 2)
  description String
  createdAt   DateTime    @default(now())

  @@index([customerId])
  @@index([status])
}

model Ticket {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id])
  subject    String
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  channel    Channel        @default(EMAIL)
  tags       String[]       @default([])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  // Status/priority/tags as seeded or submitted, so a demo visitor can reset the
  // ticket after the agent has acted on it. Null for tickets made before it existed.
  seedState  Json?
  // Set on tickets a demo visitor wrote; only that visitor sees them. Plain id (no
  // FK) so pruning visitors never cascades into ticket data.
  visitorId  String?

  messages    Message[]
  llmCalls    LlmCall[]
  compactions Compaction[]

  @@index([customerId])
  @@index([status])
  @@index([visitorId])
}

model Message {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id])
  role      MessageRole
  body      String
  // AI-authored replies land as DRAFT and only flip to SENT on human approval (HITL).
  status    MessageStatus @default(SENT)
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model KbArticle {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String
  tags      String[] @default([])
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Observability spine — one row per model call. Do not let a call happen
// without writing one of these.
// ---------------------------------------------------------------------------

model LlmCall {
  id           String   @id @default(cuid())
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])
  model        String
  inputTokens  Int
  outputTokens Int
  // cacheReadTokens / cacheWriteTokens are optional but cheap to capture and make
  // the cost story richer if you use prompt caching.
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  costUsd      Decimal  @db.Decimal(10, 6)
  latencyMs    Int
  // The tool_use blocks the model emitted on this turn, as JSON, so the dashboard
  // can show "4 model calls, 6 tool calls" without reconstructing it.
  toolCalls    Json?
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

// One row per context-compaction event — makes the "context management" pillar
// observable: how many tokens were squeezed out and the summarizer cost to do it.
model Compaction {
  id           String   @id @default(cuid())
  ticketId     String?
  ticket       Ticket?  @relation(fields: [ticketId], references: [id])
  tokensBefore Int
  tokensAfter  Int
  tokensSaved  Int
  costUsd      Decimal  @db.Decimal(10, 6) // summarizer-call cost
  model        String
  createdAt    DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Public demo guardrails (DEMO_MODE). Untouched by the nightly reseed, so spend
// caps and visitor counts survive it.
// ---------------------------------------------------------------------------

// One row per browser (httpOnly cookie id). No login: name/company are optional and
// self-reported; the IP is stored only as a salted hash.
model DemoVisitor {
  id        String    @id
  ipHash    String
  name      String?
  company   String?
  firstSeen DateTime  @default(now())
  lastSeen  DateTime  @default(now())

  runs DemoRun[]

  @@index([ipHash])
  @@index([lastSeen])
}

// One row per admitted agent run: the unit the per-visitor, per-IP, concurrency and
// spend limits count. ticketId has no FK: the nightly reseed replaces tickets, and
// these rows must outlive them for the monthly cap.
model DemoRun {
  id         String        @id @default(cuid())
  visitorId  String
  visitor    DemoVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  ipHash     String
  ticketId   String
  status     DemoRunStatus @default(RUNNING)
  costUsd    Decimal       @default(0) @db.Decimal(10, 6)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  @@index([startedAt])
  @@index([visitorId, startedAt])
  @@index([ipHash, startedAt])
  @@index([ticketId, status])
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum OrderStatus {
  PAID
  REFUNDED
  PENDING
  FAILED
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  ESCALATED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  CHAT
  WHATSAPP
  WEB
}

enum MessageRole {
  CUSTOMER
  AGENT // human support agent
  AI    // the assistant
}

enum MessageStatus {
  DRAFT // staged by the agent, awaiting human approval
  SENT
}

enum DemoRunStatus {
  RUNNING
  DONE
  ERROR
}
